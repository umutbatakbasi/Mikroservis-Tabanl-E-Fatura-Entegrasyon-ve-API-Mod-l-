# ==============================================================================
# Production Environment Variables Configuration Template
# ==============================================================================

# Application Configuration
APP_NAME="E-Invoice Integration API"
APP_VERSION="1.0.0"
API_V1_PREFIX="/api"
DEBUG=False

# Production Database (Secure Linux file path or PostgreSQL connection string)
DATABASE_URL="sqlite:////var/www/einvoice-api/invoice.db"

# Invoice Settings
INVOICE_NUMBER_PREFIX="INV"

# E-Invoice Provider Settings (MOCK or GIB)
EINVOICE_PROVIDER="MOCK"
GIB_API_KEY=""
GIB_ENDPOINT_URL="https://earsivportal.efatura.gov.tr/api"
